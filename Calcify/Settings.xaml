<Window x:Class="Calcify.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calcify"
        xmlns:properties="clr-namespace:Calcify.Properties"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Style="{StaticResource modernWindow}"
        AllowsTransparency="False"
        Title="Settings" Height="620" Width="520" MinHeight="500" MinWidth="460">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static properties:Settings.Default}, Path=DarkMode}" Value="True">
                    <Setter Property="Background" Value="#303030" />
                    <Setter Property="BorderBrush" Value="#454545" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source={x:Static properties:Settings.Default}, Path=DarkMode}" Value="False">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#E2E2E2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsDescription" TargetType="TextBlock" BasedOn="{StaticResource modernTextBlock}">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource modernHeaderFooter}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="46" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Settings" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
            <Button Grid.Column="1" x:Name="closeButton" WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{StaticResource ChromeCloseButton}" AutomationProperties.Name="Close settings" ToolTip="Close settings">
                <TextBlock FontSize="14" Text="&#xe947;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,12">
                <TextBlock Text="Preferences" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"
                           Style="{StaticResource modernTextBlock}" />
                <TextBlock Text="Customize the appearance and behavior of Calcify." Margin="0,0,0,18"
                           Style="{StaticResource SettingsDescription}" />

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold"
                                   Style="{StaticResource modernTextBlock}" />
                        <TextBlock Text="Choose how Calcify looks on this device." Margin="0,4,0,14"
                                   Style="{StaticResource SettingsDescription}" />
                        <TextBlock Text="Color scheme" FontWeight="Medium" Margin="0,0,0,8"
                                   Style="{StaticResource modernTextBlock}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DarkModeRadioButton" Content="Dark" GroupName="ColorScheme"
                                         Margin="0,0,20,0" VerticalAlignment="Center" />
                            <RadioButton x:Name="LightModeRadioButton" Content="Light" GroupName="ColorScheme"
                                         Margin="0,0,20,0" VerticalAlignment="Center" />
                            <RadioButton x:Name="SystemDefinedDarkModeRadioButton" Content="System defined"
                                         GroupName="ColorScheme" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Editor" FontSize="15" FontWeight="SemiBold"
                                   Style="{StaticResource modernTextBlock}" />
                        <TextBlock Text="Adjust text size, editor guides, and line visibility." Margin="0,4,0,12"
                                   Style="{StaticResource SettingsDescription}" />
                        <TextBlock Text="Font size" FontWeight="Medium" Margin="0,0,0,7"
                                   Style="{StaticResource modernTextBlock}" />
                        <Grid HorizontalAlignment="Left" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DecreaseFontSizeButton" Grid.Column="0" Height="30" Margin="0,0,5,0"
                                    Style="{StaticResource SearchReplaceButton}" AutomationProperties.Name="Decrease font size"
                                    ToolTip="Decrease font size">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                            <TextBox x:Name="EditorFontSizeTextBox" Grid.Column="1" Height="30" Padding="6,3"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     Style="{StaticResource SearchReplaceTextBox}" Margin="0"
                                     AutomationProperties.Name="Editor font size" />
                            <Button x:Name="IncreaseFontSizeButton" Grid.Column="2" Height="30" Margin="5,0,0,0"
                                    Style="{StaticResource SearchReplaceButton}" AutomationProperties.Name="Increase font size"
                                    ToolTip="Increase font size">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                        </Grid>
                        <CheckBox x:Name="ShowLineNumbersCheckBox" Content="Show line numbers"
                                  Style="{StaticResource SearchReplaceCheckBox}" Margin="0,4,0,0" />
                        <TextBlock Text="Display a number beside each line in the editor." Margin="22,2,0,8"
                                   Style="{StaticResource SettingsDescription}" />
                        <CheckBox x:Name="HighlightCurrentLineCheckBox" Content="Highlight current line"
                                  Style="{StaticResource SearchReplaceCheckBox}" Margin="0,4,0,0" />
                        <TextBlock Text="Emphasize the line where the caret is positioned." Margin="22,2,0,0"
                                   Style="{StaticResource SettingsDescription}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Calculation" FontSize="15" FontWeight="SemiBold"
                                   Style="{StaticResource modernTextBlock}" />
                        <TextBlock Text="Set the precision used to display results." Margin="0,4,0,12"
                                   Style="{StaticResource SettingsDescription}" />
                        <TextBlock Text="Decimal places" FontWeight="Medium" Margin="0,0,0,7"
                                   Style="{StaticResource modernTextBlock}" />
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="LessDecimalsButton" Grid.Column="0" Height="30" Margin="0,0,5,0"
                                    Style="{StaticResource SearchReplaceButton}" AutomationProperties.Name="Decrease decimal places"
                                    ToolTip="Decrease decimal places">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                            <TextBox x:Name="DecimalPlacesTextBox" Grid.Column="1" Height="30" Padding="6,3"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     Style="{StaticResource SearchReplaceTextBox}" Margin="0" />
                            <Button x:Name="MoreDecimalsButton" Grid.Column="2" Height="30" Margin="5,0,0,0"
                                    Style="{StaticResource SearchReplaceButton}" AutomationProperties.Name="Increase decimal places"
                                    ToolTip="Increase decimal places">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Document" FontSize="15" FontWeight="SemiBold"
                                   Style="{StaticResource modernTextBlock}" />
                        <TextBlock Text="Set the author name stored with your documents." Margin="0,4,0,12"
                                   Style="{StaticResource SettingsDescription}" />
                        <TextBlock Text="Document author" FontWeight="Medium" Margin="0,0,0,7"
                                   Style="{StaticResource modernTextBlock}" />
                        <TextBox x:Name="DocumentAutorName" Height="30" Padding="8,4"
                                 Style="{StaticResource SearchReplaceTextBox}" Margin="0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>